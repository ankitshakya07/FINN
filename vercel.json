{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/digest",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/portfolio",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/anomalies",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/alerts(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/announcements(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/filing/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/results-filings(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/management-changes(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/fundamentals/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/commitments/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/research/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/ask(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
