# ==============================================================================
# FINN Backend Environment Configuration
# ==============================================================================

# Application Environment & Mode
APP_ENV=development
# Set DEMO_MODE=true for frozen fixtures, false for live market data (Yahoo Finance / NSE)
DEMO_MODE=true
DATABASE_URL=sqlite:///./finn.db
CORS_ORIGINS=http://localhost:3000

# Market Data & Announcements Ingestion
ANNOUNCEMENT_TIMEOUT_SECONDS=15
ANNOUNCEMENT_RETRIES=3
ANNOUNCEMENT_REQUEST_INTERVAL_SECONDS=1.0
ANNOUNCEMENT_MAPPING_MAX_AGE_DAYS=30
ANNOUNCEMENT_LOOKBACK_DAYS=30
REFRESH_STALE_HOURS=12
BSE_SECURITY_MASTER_URL=https://api.bseindia.com/BseIndiaAPI/api/ListofScripData/w

# LLM Provider Configuration
# Compatible with OpenAI or Google Gemini (OpenAI-compatible endpoint)
# For Google Gemini free tier:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_api_key_here
# LLM_SMALL_MODEL=gemini-2.5-flash-lite
# LLM_STRONG_MODEL=gemini-2.5-flash
#
# For OpenAI:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_SMALL_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o

LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_RPM=15
LLM_DAILY_REQUEST_CAP=1500

# LLM Cost Tracking (per 1M tokens) - Set to 0.00 for free tier
LLM_SMALL_INPUT_COST_PER_1M=0.15
LLM_SMALL_OUTPUT_COST_PER_1M=0.60
LLM_STRONG_INPUT_COST_PER_1M=2.50
LLM_STRONG_OUTPUT_COST_PER_1M=10.00
