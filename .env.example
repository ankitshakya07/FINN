# LLM provider (OpenAI-compatible chat completions using Gemini)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here

# Best free model for main tasks & reasoning
LLM_STRONG_MODEL=gemini-3.8-flash

# Lightweight free model for simple/high-volume tasks
LLM_SMALL_MODEL=gemini-3.5-flash-lite

LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Zero cost for Google AI Studio Free Tier
LLM_SMALL_INPUT_COST_PER_1M=0.00
LLM_SMALL_OUTPUT_COST_PER_1M=0.00
LLM_STRONG_INPUT_COST_PER_1M=0.00
LLM_STRONG_OUTPUT_COST_PER_1M=0.00

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
